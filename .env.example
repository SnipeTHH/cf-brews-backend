# ========================================================================
# CF-Brews Backend Environment Variables Template
# Copy this file to .env and replace the values with your own.
# ========================================================================

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
ALLOYDB_CA_DATA_AGENT_ID=agent_your-alloydb-ca-data-agent-uuid
AI_STUDIO_API_KEY=your-google-ai-studio-api-key
GEMINI_API_KEY=your-google-ai-studio-api-key

# Database Connection (AlloyDB / PostgreSQL)
DB_IP=127.0.0.1
DB_USER=postgres
DB_PASS=your-database-password
